# Replace with an actually published version. Do not use latest for production.
CODEARTS_IMAGE=ghcr.io/YOUR_OWNER/codearts2api-panel:vX.Y.Z
CODEARTS_PORT=10087
TZ=Asia/Shanghai
# Caddy runs on the host; export these for its service, not just Compose's .env.
PANEL_DOMAIN=panel.example.com
PANEL_UPSTREAM=127.0.0.1:10087

# Optional Google OAuth application settings; obtain authorized client configuration.
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
